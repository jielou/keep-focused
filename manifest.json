{
  "manifest_version": 3,
  "name": "Keep Focused",
  "description": "Block distracting domains during chosen days and limit daily checking sessions.",
  "version": "0.1.0",
  "permissions": ["storage", "tabs", "webNavigation", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/keep_focused_icon_16.png",
    "32": "icons/keep_focused_icon_32.png",
    "48": "icons/keep_focused_icon_48.png",
    "128": "icons/keep_focused_icon_128.png"
  },
  "action": {
    "default_title": "Keep Focused",
    "default_popup": "src/popup.html"
  }
}
